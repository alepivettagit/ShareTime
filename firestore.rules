rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isPlaylistMember(playlistId) {
      return isSignedIn() && 
        request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.memberUids;
    }
    function isPlaylistCreator(playlistId) {
      return isSignedIn() && 
        request.auth.uid == get(/databases/$(database)/documents/playlists/$(playlistId)).data.createdBy;
    }

    // Profilo Utente
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Tabella Univocità Username (lettura pubblica per verificare se libero prima di registrarsi)
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() 
                    && request.resource.data.uid == request.auth.uid
                    && username.matches('^[a-zA-Z0-9_]{3,20}$');
      allow update, delete: if false;
    }

    // Playlist Condivise
    match /playlists/{playlistId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.memberUids);
      
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid]
                    && request.resource.data.title.size() >= 1 
                    && request.resource.data.title.size() <= 50;

      allow update: if isPlaylistCreator(playlistId)
                    || (
                      isSignedIn()
                      && request.resource.data.memberUids.hasAll(resource.data.memberUids)
                      && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
                      && request.auth.uid in request.resource.data.memberUids
                      && !(request.auth.uid in resource.data.memberUids)
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.title == resource.data.title
                    );

      allow delete: if isPlaylistCreator(playlistId);

      match /invites/{token} {
        allow read: if true;
        allow create, update, delete: if isPlaylistCreator(playlistId);
      }

      match /videos/{videoId} {
        allow read: if isPlaylistMember(playlistId);
        
        allow create: if isPlaylistMember(playlistId)
                      && request.resource.data.sharedByUid == request.auth.uid
                      && request.resource.data.youtubeId.size() == 11
                      && request.resource.data.title.size() > 0;

        allow update: if isPlaylistMember(playlistId) && (
          resource.data.sharedByUid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenForUsers'])
        );

        allow delete: if isPlaylistMember(playlistId) && (
          resource.data.sharedByUid == request.auth.uid || isPlaylistCreator(playlistId)
        );

        match /views/{userId} {
          allow read: if isPlaylistMember(playlistId);
          allow write: if isPlaylistMember(playlistId) && isOwner(userId);
        }
      }
    }
  }
}
